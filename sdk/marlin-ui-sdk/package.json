{
  "name": "@marlin/ui-sdk",
  "version": "0.1.0",
  "description": "TypeScript UI SDK bridging Vercel AI SDK data-* Generative UI parts, shadcn/Geist tokens, and Apple Liquid Glass Web Islands in Marlin UI",
